# Optional. Copy to .env only if you need to override something. Never commit .env.

# Host port the UI is exposed on (http://localhost:3000)
# OPEN_WEBUI_PORT=3000

# Image tag (https://github.com/open-webui/open-webui/releases)
# OPEN_WEBUI_VERSION=v0.11.4

# Name shown in the UI (Open WebUI appends " (Open WebUI)")
# WEBUI_NAME=Smirnof

# --- Backend (FastAPI /ask) ---
# LLM providers: Gemini is primary, Groq is the backup. Set at least one key.
# Gemini: key from https://aistudio.google.com (Get API key).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
# Groq backup: free key from https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Order to try providers in. Demo day and Gemini is flaky? Use LLM_ORDER=groq,gemini
# LLM_ORDER=gemini,groq
# LLM_TIMEOUT_SECONDS=20
# Shared secret between Open WebUI and the backend (recommended; any random string)
# TRUST_API_TOKEN=
# Endpoint used by Open WebUI. Set it empty (TRUST_API_URL=) to use mock data instead.
# TRUST_API_URL=http://backend:8000/ask

# Ollama instance (default assumes Ollama on the host)
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Only needed if you use an OpenAI-compatible API instead of / alongside Ollama
# OPENAI_API_KEY=

# Model preselected in new chats
# DEFAULT_MODELS=payroll_assistant.janssens

# Also show raw Ollama / OpenAI models in the dropdown
# ENABLE_OLLAMA_API=True
# ENABLE_OPENAI_API=True

# --- Voice ---
# Text-to-speech. Leave AUDIO_TTS_ENGINE unset to use the browser's built-in voices.
# Optional: if ElevenLabs is misconfigured or unreachable, startup falls back to browser voices.
# ElevenLabs: key from https://elevenlabs.io/app/settings/api-keys, voice ID from
# the Voices page (the default below is "Rachel").
# AUDIO_TTS_ENGINE=elevenlabs
# AUDIO_TTS_API_KEY=
# AUDIO_TTS_MODEL=eleven_multilingual_v2
# AUDIO_TTS_VOICE=21m00Tcm4TlvDq8ikWAM

# Speech-to-text. Unset = local Whisper in the container. Bigger models
# (small, medium) are more accurate but slower on CPU.
# AUDIO_STT_ENGINE=
# WHISPER_MODEL=base
# Language spoken to the mic (en, nl, fr). Unset = auto-detect per clip.
# WHISPER_LANGUAGE=
