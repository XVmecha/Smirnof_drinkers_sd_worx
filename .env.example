# Copy to .env and fill in. Never commit .env.

# Required: keep this stable or everyone gets logged out on container recreate.
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=change-me

# Host port the UI is exposed on (http://localhost:3000)
OPEN_WEBUI_PORT=3000

# Optional: point at an Ollama instance (default assumes Ollama on the host)
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional: use an OpenAI-compatible API instead of / alongside Ollama
# OPENAI_API_KEY=
